# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover" or "mix coveralls.html", coverage assets end up here.
/cover/

# Combined docs + coverage site assembled for GitHub Pages deployment in CI.
/public/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
module_o_mat-*.tar

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Vue production builds copied here by mix assets.build_vue / Docker.
/priv/vue/

# Ignore user-uploaded PDF manuals.
/priv/static/uploads/

# Ignore inventory ZIP backups created via mix inventory.export.
/priv/backups/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# SQLite database files (dev/test) and their WAL/SHM sidecar files.
*.db
*.db-shm
*.db-wal

# Local Docker / Compose secrets
.env


# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=change-me

# Hostname or LAN IP (no scheme)
# LAN example: 192.168.1.50
# Behind proxy: example.com
PHX_HOST=example.com

# http for LAN IP:PORT access; https when behind a reverse proxy
PHX_SCHEME=https

# Host port mapped to the container (also used as public URL port when PHX_SCHEME=http)
PORT=4000

# Optional: GHCR image tag (default: latest)
# IMAGE_TAG=latest

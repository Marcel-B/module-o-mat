# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=change-me

# Hostname or LAN IP (no scheme) — must match the browser Origin host
# Direct LAN: 192.168.2.197
# Behind NPM: module.lan
PHX_HOST=module.lan

# http for plain LAN / HTTP proxy; https when TLS terminates at the reverse proxy
PHX_SCHEME=http

# Host port mapped to the container
PORT=4012

# Public URL port (browser-facing).
# Behind NPM on HTTP :80 → 80
# Behind NPM with HTTPS :443 → 443
PHX_PORT=80

# Optional: allow both hostname and direct IP (LiveView WebSockets)
# PHX_CHECK_ORIGIN=http://module.lan,http://192.168.2.197:4012

# Redirect HTTP→HTTPS using X-Forwarded-Proto (only with TLS at the proxy)
# PHX_FORCE_SSL=true

# --- HTTPS behind Nginx Proxy Manager (example) ---
# PHX_HOST=module.lan
# PHX_SCHEME=https
# PHX_PORT=443
# PHX_FORCE_SSL=true
# PHX_CHECK_ORIGIN=https://module.lan
# PORT=4012

# Optional: GHCR image tag (default: latest)
# IMAGE_TAG=latest

# --- Optional: daily Nextcloud backup (WebDAV / Hetzner) ---
# Create an app password in Nextcloud (Settings → Security).
# WebDAV folder URL, e.g.:
# https://nxNNNN.your-storageshare.de/remote.php/dav/files/USER/Backups/module-o-mat
# NEXTCLOUD_BACKUP_ENABLED=true
# NEXTCLOUD_WEBDAV_URL=
# NEXTCLOUD_USERNAME=
# NEXTCLOUD_APP_PASSWORD=
# NEXTCLOUD_BACKUP_AT=03:00
# NEXTCLOUD_BACKUP_TIMEZONE=Europe/Berlin
# Minutes to wait after the last inventory edit before uploading
# NEXTCLOUD_BACKUP_IDLE_MINUTES=10
# HTTP timeout for the WebDAV upload (default 300s; ZIP with PDFs can exceed Req's 15s)
# NEXTCLOUD_BACKUP_HTTP_TIMEOUT_SECONDS=300

<Layouts.app flash={@flash}>
  <div class="pb-4 space-y-3">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <h1 class="text-lg font-semibold leading-8 text-left">
        Eurorack-Module
      </h1>

      <div class="flex flex-none gap-2">
        <.link patch={~p"/backup"} id="backup-button" class="btn">
          Datensicherung
        </.link>
        <.link patch={~p"/module_types"} id="manage-module-types-button" class="btn">
          Typen verwalten
        </.link>
        <.link
          patch={~p"/eurorack_modules/new"}
          id="new-eurorack-module-button"
          class="btn btn-primary"
        >
          Neues Modul
        </.link>
      </div>
    </div>

    <.form
      for={@filter_form}
      id="module-filter-form"
      phx-change="filter"
      class="flex w-full flex-col gap-2 sm:flex-row sm:items-end"
    >
      <div class="min-w-0 grow">
        <.input
          field={@filter_form[:q]}
          type="search"
          id="module-search-input"
          label="Suche"
          placeholder="Hersteller oder Modul suchen…"
          phx-debounce="300"
        />
      </div>

      <div class="flex w-full shrink-0 flex-col gap-2 sm:w-auto sm:flex-row sm:items-end">
        <div class="w-full sm:w-48">
          <.input
            field={@filter_form[:type]}
            type="select"
            id="module-type-filter"
            label="Typ"
            prompt="Alle Typen"
            options={Enum.map(@filter_types, &{&1, &1})}
          />
        </div>

        <div class="w-full sm:w-16">
          <.input
            field={@filter_form[:min_hp]}
            type="number"
            id="module-min-hp"
            label="Min HP"
            min="1"
            phx-debounce="300"
          />
        </div>

        <div class="w-full sm:w-16">
          <.input
            field={@filter_form[:max_hp]}
            type="number"
            id="module-max-hp"
            label="Max HP"
            min="1"
            phx-debounce="300"
          />
        </div>

        <div class="fieldset mb-2 w-auto shrink-0">
          <label>
            <span class="label mb-1 invisible select-none" aria-hidden="true">&nbsp;</span>
            <button
              type="button"
              id="clear-filters-button"
              phx-click="clear_filters"
              class="btn btn-square"
              aria-label="Filter und Suche leeren"
            >
              <.icon name="hero-x-mark" class="size-5" />
            </button>
          </label>
        </div>
      </div>
    </.form>
  </div>

  <p
    :if={@eurorack_modules == [] and not @filters_active?}
    id="no-eurorack-modules"
    class="text-base-content/70"
  >
    Es sind noch keine Module erfasst.
  </p>

  <p
    :if={@eurorack_modules == [] and @filters_active?}
    id="no-search-results"
    class="text-base-content/70"
  >
    Keine Module gefunden.
  </p>

  <table
    :if={@eurorack_modules != []}
    class="table w-full table-fixed"
    id="eurorack-modules"
  >
    <thead>
      <tr>
        <th>Modul</th>
        <th class="w-14 whitespace-nowrap">HP</th>
        <th class="w-24 text-right whitespace-nowrap">Kaufpreis</th>
        <th class="w-32 text-right whitespace-nowrap">Wert</th>
        <th class="w-60 text-right whitespace-nowrap">Aktionen</th>
      </tr>
    </thead>
    <tbody
      :for={group <- grouped_eurorack_modules(@eurorack_modules)}
      id={"eurorack-modules-#{hd(group).type}"}
    >
      <tr class="border-0 hover:bg-primary/20">
        <td colspan="5" class="bg-primary/20 font-semibold py-2">
          {hd(group).type}
          <span class="text-base-content/60 font-normal">({length(group)})</span>
        </td>
      </tr>
      <tr
        :for={eurorack_module <- group}
        id={"eurorack-module-#{eurorack_module.id}"}
        class="hover:bg-base-200"
      >
        <td class="truncate">
          {eurorack_module.manufacturer} - {eurorack_module.name}
        </td>
        <td class="w-14 whitespace-nowrap">{eurorack_module.hp}</td>
        <td class="w-24 text-right whitespace-nowrap tabular-nums">
          {format_euro(eurorack_module.purchase_price)}
        </td>
        <td class="w-32 text-right whitespace-nowrap tabular-nums">
          <span title={price_range_title(Map.get(@price_ranges, eurorack_module.id))}>
            {format_value_cell(
              Map.get(@price_ranges, eurorack_module.id),
              eurorack_module.current_value
            )}
          </span>
        </td>
        <td class="w-60 whitespace-nowrap">
          <div class="flex shrink-0 gap-1 justify-end">
            <%= if eurorack_module.manual_pdf_key do %>
              <.link
                href={~p"/eurorack_modules/#{eurorack_module.id}/manual"}
                id={"open-manual-pdf-#{eurorack_module.id}"}
                class="btn btn-ghost btn-xs"
                title="PDF oeffnen"
                aria-label="PDF oeffnen"
                target="_blank"
                rel="noopener noreferrer"
              >
                <.icon name="hero-document-text" />
              </.link>
            <% else %>
              <button
                type="button"
                id={"open-manual-pdf-#{eurorack_module.id}"}
                class="btn btn-ghost btn-xs btn-disabled"
                title="Keine PDF-Anleitung"
                aria-label="Keine PDF-Anleitung"
                disabled
              >
                <.icon name="hero-document-text" />
              </button>
            <% end %>
            <.youtube_play_button eurorack_module={eurorack_module} />
            <.link
              patch={~p"/eurorack_modules/#{eurorack_module.id}"}
              id={"show-eurorack-module-#{eurorack_module.id}"}
              class="btn btn-ghost btn-xs"
              title="Anzeigen"
              aria-label="Anzeigen"
            >
              <.icon name="hero-eye" />
            </.link>
            <.link
              patch={~p"/eurorack_modules/#{eurorack_module.id}/edit"}
              id={"edit-eurorack-module-#{eurorack_module.id}"}
              class="btn btn-ghost btn-xs"
              title="Bearbeiten"
              aria-label="Bearbeiten"
            >
              <.icon name="hero-pencil-square" />
            </.link>
            <button
              type="button"
              id={"delete-eurorack-module-#{eurorack_module.id}"}
              class="btn btn-ghost btn-xs text-error"
              title="Loeschen"
              aria-label="Loeschen"
              phx-click="delete"
              phx-value-id={eurorack_module.id}
            >
              <.icon name="hero-trash" />
            </button>
          </div>
        </td>
      </tr>
    </tbody>
    <tfoot id="inventory-stats">
      <tr class="border-t-2 border-base-300 font-semibold">
        <td class="py-2">
          <span>
            {@inventory_stats.count}
            {if @inventory_stats.count == 1, do: "Modul", else: "Module"}
          </span>
          <span class="block text-xs font-normal text-base-content/60 tabular-nums">
            {format_hp_width(@inventory_stats)}
          </span>
        </td>
        <td class="w-14 whitespace-nowrap tabular-nums">{@inventory_stats.total_hp}</td>
        <td class="w-24 text-right whitespace-nowrap tabular-nums">
          {format_euro_sum(@inventory_stats.total_purchase_price)}
        </td>
        <td class="w-32 text-right whitespace-nowrap tabular-nums">
          {format_euro_sum(@inventory_stats.total_current_value)}
        </td>
        <td class="w-60"></td>
      </tr>
    </tfoot>
  </table>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".YoutubePreview">
    export default {
      mounted() {
        this.overlay = null

        this.hide = () => {
          if (this.overlay) {
            this.overlay.remove()
            this.overlay = null
          }
        }

        this.show = () => {
          const embedUrl = this.el.dataset.embedUrl
          if (!embedUrl) return

          this.hide()

          const overlay = document.createElement("div")
          overlay.id = `youtube-preview-${this.el.id}`
          overlay.setAttribute(
            "class",
            "fixed z-50 w-80 max-w-[min(20rem,calc(100vw-1.5rem))] overflow-hidden rounded-lg border border-base-300 bg-base-100 shadow-xl"
          )
          overlay.style.pointerEvents = "none"

          const iframe = document.createElement("iframe")
          iframe.src = embedUrl
          iframe.title = "YouTube-Vorschau"
          iframe.setAttribute(
            "class",
            "aspect-video h-auto w-full border-0"
          )
          iframe.allow =
            "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          iframe.allowFullscreen = true

          overlay.appendChild(iframe)
          document.body.appendChild(overlay)
          this.overlay = overlay

          const rect = this.el.getBoundingClientRect()
          const overlayRect = overlay.getBoundingClientRect()
          let top = rect.bottom + 8
          let left = rect.right - overlayRect.width

          if (left < 8) left = 8
          if (top + overlayRect.height > window.innerHeight - 8) {
            top = Math.max(8, rect.top - overlayRect.height - 8)
          }

          overlay.style.top = `${top}px`
          overlay.style.left = `${left}px`
        }

        this.onEnter = () => this.show()
        this.onLeave = () => this.hide()
        this.onScroll = () => this.hide()

        this.el.addEventListener("mouseenter", this.onEnter)
        this.el.addEventListener("mouseleave", this.onLeave)
        window.addEventListener("scroll", this.onScroll, true)
      },
      destroyed() {
        this.hide()
        this.el.removeEventListener("mouseenter", this.onEnter)
        this.el.removeEventListener("mouseleave", this.onLeave)
        window.removeEventListener("scroll", this.onScroll, true)
      }
    }
  </script>

  <.modal
    :if={@live_action in [:new, :edit, :show]}
    id="eurorack-module-modal"
    box_class="sm:max-w-2xl max-h-[calc(100vh-5em)] flex flex-col overflow-hidden"
  >
    <:title>{@page_title}</:title>

    <div
      :if={@live_action == :show}
      id="eurorack-module-show"
      class="flex min-h-0 flex-1 flex-col"
    >
      <div class="min-h-0 flex-1 overflow-y-auto">
        <.eurorack_module_fields
          form={@form}
          disabled={true}
          manufacturers={@manufacturers}
          types={@types}
          eurorack_module={@eurorack_module}
        />
      </div>

      <div class="flex shrink-0 gap-2 justify-end pt-4">
        <.link patch={~p"/"} id="close-eurorack-module-button" class="btn">
          Schliessen
        </.link>
      </div>
    </div>

    <.form
      :if={@live_action in [:new, :edit]}
      for={@form}
      id="eurorack-module-form"
      class="flex min-h-0 flex-1 flex-col"
      phx-change="validate"
      phx-submit="save"
    >
      <div class="min-h-0 flex-1 overflow-y-auto">
        <.eurorack_module_fields
          form={@form}
          disabled={false}
          manufacturers={@manufacturers}
          types={@types}
          uploads={@uploads}
          eurorack_module={@eurorack_module}
        />
      </div>

      <div class="flex shrink-0 gap-2 justify-end pt-4">
        <.link patch={~p"/"} id="cancel-eurorack-module-button" class="btn">
          Abbrechen
        </.link>
        <.button type="submit" variant="primary" id="save-eurorack-module-button">
          {if @live_action == :edit, do: "Aktualisieren", else: "Speichern"}
        </.button>
      </div>
    </.form>
  </.modal>

  <.modal :if={@live_action == :manage_types} id="module-types-modal">
    <:title>Typen verwalten</:title>

    <div class="mb-4">
      <h4 class="font-semibold text-sm mb-2">Vorhandene Typen</h4>
      <p class="text-base-content/70 text-xs mb-2">
        Bereits verwendete Typen sind farblich hervorgehoben.
      </p>
      <p :if={@module_types == []} class="text-base-content/70 text-sm">
        Es sind noch keine Typen definiert.
      </p>
      <ul :if={@module_types != []} id="module-types-list" class="flex flex-wrap gap-2">
        <li :for={module_type <- @module_types} id={"module-type-#{module_type.id}"}>
          <.form
            :if={@editing_module_type && @editing_module_type.id == module_type.id}
            for={@module_type_edit_form}
            id={"module-type-edit-form-#{module_type.id}"}
            phx-change="validate_edit_module_type"
            phx-submit="update_module_type"
            class="flex items-center gap-1"
          >
            <.input
              field={@module_type_edit_form[:name]}
              type="text"
              id={"module-type-edit-name-#{module_type.id}"}
              class="input input-xs"
            />
            <button
              type="submit"
              class="btn btn-ghost btn-xs"
              title="Speichern"
              aria-label={"Typ #{module_type.name} speichern"}
            >
              <.icon name="hero-check" class="size-4" />
            </button>
            <button
              type="button"
              class="btn btn-ghost btn-xs"
              title="Abbrechen"
              aria-label="Bearbeiten abbrechen"
              phx-click="cancel_edit_module_type"
            >
              <.icon name="hero-x-mark" class="size-4" />
            </button>
          </.form>

          <div
            :if={!(@editing_module_type && @editing_module_type.id == module_type.id)}
            class={[
              "badge gap-1",
              (module_type.name in @used_module_types && "badge-primary") || "badge-outline"
            ]}
          >
            {module_type.name}
            <button
              :if={module_type.name != Inventory.fallback_type_name()}
              type="button"
              id={"edit-module-type-#{module_type.id}"}
              class="cursor-pointer"
              title="Bearbeiten"
              aria-label={"Typ #{module_type.name} bearbeiten"}
              phx-click="edit_module_type"
              phx-value-id={module_type.id}
            >
              <.icon name="hero-pencil-square" class="size-3" />
            </button>
            <button
              :if={module_type.name != Inventory.fallback_type_name()}
              type="button"
              id={"delete-module-type-#{module_type.id}"}
              class="cursor-pointer"
              title="Loeschen"
              aria-label={"Typ #{module_type.name} loeschen"}
              phx-click="delete_module_type"
              phx-value-id={module_type.id}
            >
              <.icon name="hero-x-mark" class="size-3" />
            </button>
          </div>
        </li>
      </ul>
    </div>

    <.form
      for={@module_type_form}
      id="module-type-form"
      phx-change="validate_module_type"
      phx-submit="add_module_type"
    >
      <.input
        field={@module_type_form[:name]}
        type="text"
        label="Neuer Typ"
        placeholder="z.B. Granular"
      />

      <div class="flex gap-2 justify-end mt-4">
        <.link patch={~p"/"} id="close-module-types-button" class="btn">
          Schliessen
        </.link>
        <.button type="submit" variant="primary" id="add-module-type-button">
          Hinzufuegen
        </.button>
      </div>
    </.form>
  </.modal>

  <.modal :if={@live_action == :backup} id="backup-modal">
    <:title>Datensicherung</:title>

    <div class="space-y-6">
      <section id="backup-export-section" class="space-y-2">
        <h4 class="font-semibold text-sm">Export</h4>
        <p class="text-base-content/70 text-sm">
          Exportiert alle Module, Typen, YouTube-Videos und PDF-Anleitungen als ZIP-Datei.
          Soft-geloeschte Eintraege sind nicht enthalten.
        </p>
        <.link
          href={~p"/backup/export"}
          id="export-backup-button"
          class="btn btn-primary"
        >
          <.icon name="hero-arrow-down-tray" class="size-4" /> Backup herunterladen
        </.link>
      </section>

      <section id="backup-import-section" class="space-y-2">
        <h4 class="font-semibold text-sm">Import</h4>
        <p class="text-base-content/70 text-sm">
          Stellt ein zuvor erstelltes Backup wieder her.
          <strong>Alle vorhandenen Daten werden dabei ersetzt.</strong>
        </p>

        <form
          id="backup-import-form"
          phx-change="validate_backup"
          phx-submit="import_backup"
          class="space-y-3"
        >
          <div
            class="border border-dashed border-base-300 rounded-lg p-4 text-center"
            phx-drop-target={@uploads.backup.ref}
          >
            <p class="text-sm text-base-content/70 mb-2">
              ZIP hierher ziehen oder Datei auswaehlen
            </p>
            <.live_file_input
              upload={@uploads.backup}
              class="file-input file-input-bordered file-input-sm w-full max-w-xs"
            />
          </div>

          <div
            :for={entry <- @uploads.backup.entries}
            id={"backup-upload-entry-#{entry.ref}"}
            class="flex items-center gap-2 text-sm"
          >
            <span class="truncate">{entry.client_name}</span>
            <span class="text-base-content/50">{entry.progress}%</span>
            <button
              type="button"
              id={"cancel-backup-upload-#{entry.ref}"}
              class="btn btn-ghost btn-xs"
              phx-click="cancel_backup_upload"
              phx-value-ref={entry.ref}
            >
              Abbrechen
            </button>
          </div>

          <p
            :for={err <- upload_errors(@uploads.backup)}
            class="flex gap-2 items-center text-sm text-error"
          >
            <.icon name="hero-exclamation-circle" class="size-5" />
            {translate_backup_upload_error(err)}
          </p>
          <div :for={entry <- @uploads.backup.entries}>
            <p
              :for={err <- upload_errors(@uploads.backup, entry)}
              class="flex gap-2 items-center text-sm text-error"
            >
              <.icon name="hero-exclamation-circle" class="size-5" />
              {translate_backup_upload_error(err)}
            </p>
          </div>

          <div class="flex gap-2 justify-end pt-2">
            <.link patch={~p"/"} id="close-backup-button" class="btn">
              Schliessen
            </.link>
            <.button type="submit" variant="primary" id="import-backup-button">
              Backup importieren
            </.button>
          </div>
        </form>
      </section>
    </div>
  </.modal>

  <.modal :if={@module_to_delete} id="delete-eurorack-module-modal">
    <:title>Modul loeschen</:title>

    <p>
      Soll das Modul <strong>{@module_to_delete && @module_to_delete.name}</strong>
      wirklich geloescht werden? Diese Aktion kann nicht rueckgaengig gemacht werden.
    </p>

    <div class="flex gap-2 justify-end mt-4">
      <button
        type="button"
        id="cancel-delete-eurorack-module-button"
        class="btn"
        phx-click="cancel_delete"
      >
        Abbrechen
      </button>
      <button
        type="button"
        id="confirm-delete-eurorack-module-button"
        class="btn btn-error"
        phx-click="confirm_delete"
      >
        Loeschen
      </button>
    </div>
  </.modal>
</Layouts.app>

<Layouts.app flash={@flash}>
  <div class="pb-4 space-y-3">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <h1 class="text-lg font-semibold leading-8 text-left">
        Eurorack-Module
      </h1>

      <div class="flex flex-none gap-2">
        <.link patch={~p"/module_types"} id="manage-module-types-button" class="btn">
          Typen verwalten
        </.link>
        <.link
          patch={~p"/eurorack_modules/new"}
          id="new-eurorack-module-button"
          class="btn btn-primary"
        >
          Neues Modul
        </.link>
      </div>
    </div>

    <.form
      for={@filter_form}
      id="module-filter-form"
      phx-change="filter"
      class="flex w-full flex-col gap-2 sm:flex-row sm:items-end"
    >
      <div class="min-w-0 grow">
        <.input
          field={@filter_form[:q]}
          type="search"
          id="module-search-input"
          label="Suche"
          placeholder="Hersteller oder Modul suchen…"
          phx-debounce="300"
        />
      </div>

      <div class="flex w-full shrink-0 flex-col gap-2 sm:w-auto sm:flex-row sm:items-end">
        <div class="w-full sm:w-48">
          <.input
            field={@filter_form[:type]}
            type="select"
            id="module-type-filter"
            label="Typ"
            prompt="Alle Typen"
            options={Enum.map(@filter_types, &{&1, &1})}
          />
        </div>

        <div class="w-full sm:w-16">
          <.input
            field={@filter_form[:min_hp]}
            type="number"
            id="module-min-hp"
            label="Min HP"
            min="1"
            phx-debounce="300"
          />
        </div>

        <div class="w-full sm:w-16">
          <.input
            field={@filter_form[:max_hp]}
            type="number"
            id="module-max-hp"
            label="Max HP"
            min="1"
            phx-debounce="300"
          />
        </div>

        <div class="fieldset mb-2 w-auto shrink-0">
          <label>
            <span class="label mb-1 invisible select-none" aria-hidden="true">&nbsp;</span>
            <button
              type="button"
              id="clear-filters-button"
              phx-click="clear_filters"
              class="btn btn-square"
              aria-label="Filter und Suche leeren"
            >
              <.icon name="hero-x-mark" class="size-5" />
            </button>
          </label>
        </div>
      </div>
    </.form>
  </div>

  <p
    :if={@eurorack_modules == [] and not @filters_active?}
    id="no-eurorack-modules"
    class="text-base-content/70"
  >
    Es sind noch keine Module erfasst.
  </p>

  <p
    :if={@eurorack_modules == [] and @filters_active?}
    id="no-search-results"
    class="text-base-content/70"
  >
    Keine Module gefunden.
  </p>

  <div :for={group <- grouped_eurorack_modules(@eurorack_modules)} class="mb-8">
    <h2 class="text-base font-semibold mb-2">
      {hd(group).type}
      <span class="text-base-content/50 font-normal">({length(group)})</span>
    </h2>

    <table class="table table-zebra" id={"eurorack-modules-#{hd(group).type}"}>
      <thead>
        <tr>
          <th>Hersteller</th>
          <th>Modul</th>
          <th>HP</th>
          <th class="text-right">Aktionen</th>
        </tr>
      </thead>
      <tbody>
        <tr :for={eurorack_module <- group} id={"eurorack-module-#{eurorack_module.id}"}>
          <td>{eurorack_module.manufacturer}</td>
          <td>{eurorack_module.name}</td>
          <td>{eurorack_module.hp}</td>
          <td>
            <div class="flex gap-2 justify-end">
              <.link
                :if={eurorack_module.manual_pdf_key}
                href={~p"/eurorack_modules/#{eurorack_module.id}/manual"}
                id={"open-manual-pdf-#{eurorack_module.id}"}
                class="btn btn-ghost btn-xs"
                title="PDF oeffnen"
                aria-label="PDF oeffnen"
                target="_blank"
                rel="noopener noreferrer"
              >
                <.icon name="hero-document-text" />
              </.link>
              <.link
                patch={~p"/eurorack_modules/#{eurorack_module.id}"}
                id={"show-eurorack-module-#{eurorack_module.id}"}
                class="btn btn-ghost btn-xs"
                title="Anzeigen"
                aria-label="Anzeigen"
              >
                <.icon name="hero-eye" />
              </.link>
              <.link
                patch={~p"/eurorack_modules/#{eurorack_module.id}/edit"}
                id={"edit-eurorack-module-#{eurorack_module.id}"}
                class="btn btn-ghost btn-xs"
                title="Bearbeiten"
                aria-label="Bearbeiten"
              >
                <.icon name="hero-pencil-square" />
              </.link>
              <button
                type="button"
                id={"delete-eurorack-module-#{eurorack_module.id}"}
                class="btn btn-ghost btn-xs text-error"
                title="Loeschen"
                aria-label="Loeschen"
                phx-click="delete"
                phx-value-id={eurorack_module.id}
              >
                <.icon name="hero-trash" />
              </button>
            </div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <.modal
    :if={@live_action in [:new, :edit, :show]}
    id="eurorack-module-modal"
    box_class="sm:max-w-2xl"
  >
    <:title>{@page_title}</:title>

    <div :if={@live_action == :show} id="eurorack-module-show">
      <.eurorack_module_fields
        form={@form}
        disabled={true}
        manufacturers={@manufacturers}
        types={@types}
        eurorack_module={@eurorack_module}
      />

      <div class="flex gap-2 justify-end mt-4">
        <.link patch={~p"/"} id="close-eurorack-module-button" class="btn">
          Schliessen
        </.link>
      </div>
    </div>

    <.form
      :if={@live_action in [:new, :edit]}
      for={@form}
      id="eurorack-module-form"
      phx-change="validate"
      phx-submit="save"
    >
      <.eurorack_module_fields
        form={@form}
        disabled={false}
        manufacturers={@manufacturers}
        types={@types}
        uploads={@uploads}
        eurorack_module={@eurorack_module}
      />

      <div class="flex gap-2 justify-end mt-4">
        <.link patch={~p"/"} id="cancel-eurorack-module-button" class="btn">
          Abbrechen
        </.link>
        <.button type="submit" variant="primary" id="save-eurorack-module-button">
          {if @live_action == :edit, do: "Aktualisieren", else: "Speichern"}
        </.button>
      </div>
    </.form>
  </.modal>

  <.modal :if={@live_action == :manage_types} id="module-types-modal">
    <:title>Typen verwalten</:title>

    <div class="mb-4">
      <h4 class="font-semibold text-sm mb-2">Vorhandene Typen</h4>
      <p class="text-base-content/70 text-xs mb-2">
        Bereits verwendete Typen sind farblich hervorgehoben.
      </p>
      <p :if={@module_types == []} class="text-base-content/70 text-sm">
        Es sind noch keine Typen definiert.
      </p>
      <ul :if={@module_types != []} id="module-types-list" class="flex flex-wrap gap-2">
        <li :for={module_type <- @module_types} id={"module-type-#{module_type.id}"}>
          <.form
            :if={@editing_module_type && @editing_module_type.id == module_type.id}
            for={@module_type_edit_form}
            id={"module-type-edit-form-#{module_type.id}"}
            phx-change="validate_edit_module_type"
            phx-submit="update_module_type"
            class="flex items-center gap-1"
          >
            <.input
              field={@module_type_edit_form[:name]}
              type="text"
              id={"module-type-edit-name-#{module_type.id}"}
              class="input input-xs"
            />
            <button
              type="submit"
              class="btn btn-ghost btn-xs"
              title="Speichern"
              aria-label={"Typ #{module_type.name} speichern"}
            >
              <.icon name="hero-check" class="size-4" />
            </button>
            <button
              type="button"
              class="btn btn-ghost btn-xs"
              title="Abbrechen"
              aria-label="Bearbeiten abbrechen"
              phx-click="cancel_edit_module_type"
            >
              <.icon name="hero-x-mark" class="size-4" />
            </button>
          </.form>

          <div
            :if={!(@editing_module_type && @editing_module_type.id == module_type.id)}
            class={[
              "badge gap-1",
              (module_type.name in @used_module_types && "badge-primary") || "badge-outline"
            ]}
          >
            {module_type.name}
            <button
              :if={module_type.name != Inventory.fallback_type_name()}
              type="button"
              id={"edit-module-type-#{module_type.id}"}
              class="cursor-pointer"
              title="Bearbeiten"
              aria-label={"Typ #{module_type.name} bearbeiten"}
              phx-click="edit_module_type"
              phx-value-id={module_type.id}
            >
              <.icon name="hero-pencil-square" class="size-3" />
            </button>
            <button
              :if={module_type.name != Inventory.fallback_type_name()}
              type="button"
              id={"delete-module-type-#{module_type.id}"}
              class="cursor-pointer"
              title="Loeschen"
              aria-label={"Typ #{module_type.name} loeschen"}
              phx-click="delete_module_type"
              phx-value-id={module_type.id}
            >
              <.icon name="hero-x-mark" class="size-3" />
            </button>
          </div>
        </li>
      </ul>
    </div>

    <.form
      for={@module_type_form}
      id="module-type-form"
      phx-change="validate_module_type"
      phx-submit="add_module_type"
    >
      <.input
        field={@module_type_form[:name]}
        type="text"
        label="Neuer Typ"
        placeholder="z.B. Granular"
      />

      <div class="flex gap-2 justify-end mt-4">
        <.link patch={~p"/"} id="close-module-types-button" class="btn">
          Schliessen
        </.link>
        <.button type="submit" variant="primary" id="add-module-type-button">
          Hinzufuegen
        </.button>
      </div>
    </.form>
  </.modal>

  <.modal :if={@module_to_delete} id="delete-eurorack-module-modal">
    <:title>Modul loeschen</:title>

    <p>
      Soll das Modul <strong>{@module_to_delete && @module_to_delete.name}</strong>
      wirklich geloescht werden? Diese Aktion kann nicht rueckgaengig gemacht werden.
    </p>

    <div class="flex gap-2 justify-end mt-4">
      <button
        type="button"
        id="cancel-delete-eurorack-module-button"
        class="btn"
        phx-click="cancel_delete"
      >
        Abbrechen
      </button>
      <button
        type="button"
        id="confirm-delete-eurorack-module-button"
        class="btn btn-error"
        phx-click="confirm_delete"
      >
        Loeschen
      </button>
    </div>
  </.modal>
</Layouts.app>

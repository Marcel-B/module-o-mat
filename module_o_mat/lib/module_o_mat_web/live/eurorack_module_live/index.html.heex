<Layouts.app flash={@flash}>
  <.header>
    Eurorack-Module
    <:actions>
      <.link
        patch={~p"/eurorack_modules/new"}
        id="new-eurorack-module-button"
        class="btn btn-primary"
      >
        Neues Modul
      </.link>
    </:actions>
  </.header>

  <p :if={@eurorack_modules == []} id="no-eurorack-modules" class="text-base-content/70">
    Es sind noch keine Module erfasst.
  </p>

  <div :for={group <- grouped_eurorack_modules(@eurorack_modules)} class="mb-8">
    <h2 class="text-base font-semibold mb-2">
      {type_label(hd(group).type)}
      <span class="text-base-content/50 font-normal">({length(group)})</span>
    </h2>

    <table class="table table-zebra" id={"eurorack-modules-#{hd(group).type}"}>
      <thead>
        <tr>
          <th>Hersteller</th>
          <th>Modul</th>
          <th>Typ</th>
          <th>HP</th>
          <th class="text-right">Aktionen</th>
        </tr>
      </thead>
      <tbody>
        <tr :for={eurorack_module <- group} id={"eurorack-module-#{eurorack_module.id}"}>
          <td>{eurorack_module.manufacturer}</td>
          <td>{eurorack_module.name}</td>
          <td>{type_label(eurorack_module.type)}</td>
          <td>{eurorack_module.hp}</td>
          <td>
            <div class="flex gap-2 justify-end">
              <.link
                patch={~p"/eurorack_modules/#{eurorack_module.id}"}
                id={"show-eurorack-module-#{eurorack_module.id}"}
                class="btn btn-ghost btn-xs"
                title="Anzeigen"
                aria-label="Anzeigen"
              >
                <.icon name="hero-eye" />
              </.link>
              <.link
                patch={~p"/eurorack_modules/#{eurorack_module.id}/edit"}
                id={"edit-eurorack-module-#{eurorack_module.id}"}
                class="btn btn-ghost btn-xs"
                title="Bearbeiten"
                aria-label="Bearbeiten"
              >
                <.icon name="hero-pencil-square" />
              </.link>
              <button
                type="button"
                id={"delete-eurorack-module-#{eurorack_module.id}"}
                class="btn btn-ghost btn-xs text-error"
                title="Loeschen"
                aria-label="Loeschen"
                phx-click="delete"
                phx-value-id={eurorack_module.id}
              >
                <.icon name="hero-trash" />
              </button>
            </div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <.modal
    :if={@live_action in [:new, :edit, :show]}
    id="eurorack-module-modal"
    box_class="sm:max-w-2xl"
  >
    <:title>{@page_title}</:title>

    <div :if={@live_action == :show} id="eurorack-module-show">
      <.eurorack_module_fields form={@form} disabled={true} />

      <div class="flex gap-2 justify-end mt-4">
        <.link patch={~p"/"} id="close-eurorack-module-button" class="btn">
          Schliessen
        </.link>
      </div>
    </div>

    <.form
      :if={@live_action in [:new, :edit]}
      for={@form}
      id="eurorack-module-form"
      phx-change="validate"
      phx-submit="save"
    >
      <.eurorack_module_fields form={@form} disabled={false} />

      <div class="flex gap-2 justify-end mt-4">
        <.link patch={~p"/"} id="cancel-eurorack-module-button" class="btn">
          Abbrechen
        </.link>
        <.button type="submit" variant="primary" id="save-eurorack-module-button">
          {if @live_action == :edit, do: "Aktualisieren", else: "Speichern"}
        </.button>
      </div>
    </.form>
  </.modal>

  <.modal :if={@module_to_delete} id="delete-eurorack-module-modal">
    <:title>Modul loeschen</:title>

    <p>
      Soll das Modul <strong>{@module_to_delete && @module_to_delete.name}</strong>
      wirklich geloescht werden? Diese Aktion kann nicht rueckgaengig gemacht werden.
    </p>

    <div class="flex gap-2 justify-end mt-4">
      <button
        type="button"
        id="cancel-delete-eurorack-module-button"
        class="btn"
        phx-click="cancel_delete"
      >
        Abbrechen
      </button>
      <button
        type="button"
        id="confirm-delete-eurorack-module-button"
        class="btn btn-error"
        phx-click="confirm_delete"
      >
        Loeschen
      </button>
    </div>
  </.modal>
</Layouts.app>
